<Window x:Class="MakeMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make Music" Height="820" Width="1360"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
    Closing="Window_Closing"
        Background="#F4F6F3" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#202923" />
        <SolidColorBrush x:Key="Muted" Color="#778078" />
        <SolidColorBrush x:Key="Line" Color="#E1E6E0" />
        <SolidColorBrush x:Key="Paper" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#32664D" />
        <SolidColorBrush x:Key="AccentLight" Color="#EAF1EC" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentLight}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{StaticResource Accent}" CornerRadius="5" Margin="0,0,11,0">
                        <TextBlock Text="M" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MAKE MUSIC" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="OFFLINE STUDIO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="현재 프로젝트" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Padding="0" Background="Transparent"
                             FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="열기" Style="{StaticResource ActionButton}" Click="OpenProject_Click" />
                    <Button Content="저장" Style="{StaticResource PrimaryButton}" Margin="7,0,12,0" Click="SaveProject_Click" />
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="11,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding SaveStatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SaveStatus}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="252" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="PROJECT WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="프로젝트 관리" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,4,0,12" />
                            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,7" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                     FontSize="12" Foreground="{StaticResource Ink}" />
                            <Button Content="새 프로젝트" Style="{StaticResource PrimaryButton}" Margin="0,7,0,0" Click="NewProject_Click" />
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,12" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="프로젝트 악기" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="+ 악기" Style="{StaticResource ActionButton}" Padding="7,4" FontSize="11" Click="AddInstrument_Click" />
                            </DockPanel>
                            <ComboBox x:Name="InstrumentTypePicker" SelectedIndex="0" Padding="6" Margin="0,0,0,8" FontSize="11">
                                <ComboBoxItem Content="피아노" />
                                <ComboBoxItem Content="기타" />
                                <ComboBoxItem Content="베이스" />
                                <ComboBoxItem Content="바이올린" />
                                <ComboBoxItem Content="첼로" />
                                <ComboBoxItem Content="플루트" />
                                <ComboBoxItem Content="신스" />
                                <ComboBoxItem Content="드럼" />
                            </ComboBox>
                            <Button Content="오디오 파일 가져오기" Style="{StaticResource ActionButton}" Padding="8,6" Click="ImportAudio_Click" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding InstrumentTracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#EAF1EC" VerticalAlignment="Center">
                                            <TextBlock Text="♪" FontSize="13" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TrackDescription}" FontSize="9" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#C58C3A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Fill" Value="#32664D" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Fill" Value="#B64A42" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="대기 중" />
                                                        <Setter Property="Foreground" Value="#9A6D2E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Text" Value="작업 중" />
                                                                <Setter Property="Foreground" Value="#32664D" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Text" Value="비활성화" />
                                                                <Setter Property="Foreground" Value="#B64A42" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="3" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                                Content="×" FontSize="15" Foreground="#A54835"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                ToolTip="악기 삭제" Click="RemoveInstrumentItem_Click">
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="#202923" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="12,0,0,0" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="INSTRUMENT WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#AEBAB0" />
                                <TextBlock Text="작업 악기" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#344239" CornerRadius="3" Padding="9,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAudioTrack.AudioStatus, TargetNullValue=타임라인에서 오디오를 선택하세요}" FontSize="10" Foreground="#D7E0D8" />
                            </Border>
                        </DockPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBox Text="{Binding SelectedTrack.Name, UpdateSourceTrigger=PropertyChanged, TargetNullValue=악기를 선택하세요}"
                                     FontSize="24" FontWeight="SemiBold" Foreground="#E3EAE4" Background="Transparent"
                                     BorderThickness="0" TextAlignment="Center" HorizontalContentAlignment="Center"
                                     MaxLength="100" LostFocus="InstrumentName_LostFocus"
                                     IsEnabled="{Binding HasSelectedTrack}" />
                            <TextBlock Text="{Binding SelectedTrack.TrackDescription, TargetNullValue=프로젝트 악기 목록에서 작업할 악기를 선택하세요}"
                                       FontSize="12" Foreground="#AEBAB0" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            <DockPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="역할" FontSize="11" Foreground="#AEBAB0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="230" ItemsSource="{Binding InstrumentRoles}" IsEditable="True"
                                          Text="{Binding SelectedTrack.Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="6,4" FontSize="11" IsEnabled="{Binding HasSelectedTrack}"
                                          ToolTip="역할을 선택하거나 직접 입력하세요"
                                          LostFocus="InstrumentRolePicker_LostFocus" />
                            </DockPanel>
                            <TextBlock Text="선택한 오디오 미리듣기" FontSize="11" Foreground="#AEBAB0" Margin="0,28,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedAudioTrack.AudioFileName, TargetNullValue=프로젝트 관리에서 오디오를 가져오세요}" FontSize="10" Foreground="#7F9083" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                        <DockPanel Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="재생" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="6,0,0,0" Click="PlaySelectedAudio_Click" IsEnabled="{Binding CanPlaySelectedAudio}" />
                                <Button Content="정지" Style="{StaticResource ActionButton}" Padding="9,6" Margin="6,0,0,0" Click="StopAudio_Click" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AudioStatus}" FontSize="10" Foreground="#AEBAB0" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,12,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="MIXER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="전체 악기 조정" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="MASTER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="공통 기준음 A4" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" Text="Hz" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <TextBox Text="{Binding MasterReferencePitch, UpdateSourceTrigger=LostFocus}" Padding="4,2" TextAlignment="Right" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                            </DockPanel>
                        </Grid>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="전체 미세 조율" FontSize="10" Foreground="{StaticResource Muted}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MasterFineTuneCents, StringFormat={}{0:+#;-#;0} cents}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </DockPanel>
                        <Slider Minimum="-100" Maximum="100" TickFrequency="1" Margin="0,-3,0,2" Value="{Binding MasterFineTuneCents, Mode=TwoWay}" />
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,2,0,5" />
                        <ItemsControl ItemsSource="{Binding InstrumentTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="31" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Content="M" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="음소거" Padding="4,1" FontSize="8" />
                                            <ToggleButton Content="S" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="솔로" Padding="4,1" FontSize="8" Margin="2,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,5,0,5" />
                        <TextBlock Text="오디오 채널" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,3" />
                        <ItemsControl ItemsSource="{Binding AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="31" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Content="M" IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="오디오 음소거" Padding="4,1" FontSize="8" />
                                            <ToggleButton Content="S" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="오디오 솔로" Padding="4,1" FontSize="8" Margin="2,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="1" Background="{StaticResource Line}" />
                    <Grid Grid.Column="2" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="작업 결과" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="  ·  타임라인" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="WAV 오디오 트랙" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="선택 오디오 제거" Style="{StaticResource ActionButton}" Padding="6,3" FontSize="9"
                                        Click="RemoveSelectedAudioTrack_Click" IsEnabled="{Binding HasSelectedAudioTrack}" />
                            </StackPanel>
                        </DockPanel>
                        <UniformGrid Grid.Row="1" Rows="1" Columns="8" Margin="98,3,0,0">
                            <TextBlock Text="1" FontSize="9" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="5" FontSize="9" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="9" FontSize="9" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="13" FontSize="9" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="17" FontSize="9" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="21" FontSize="9" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="25" FontSize="9" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="29" FontSize="9" Foreground="{StaticResource Muted}" />
                        </UniformGrid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding InstrumentTracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="98" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <UniformGrid Grid.Column="1" Rows="1" Columns="8">
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0" />
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" />
                                            </UniformGrid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ListBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="98" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="1" Background="#DCEBF3" BorderBrush="#A7C8D7" BorderThickness="1" CornerRadius="3" Margin="2,3" Padding="7,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding AudioFileName}" FontSize="9" FontWeight="SemiBold" Foreground="#274B5D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}" FontSize="9" Foreground="#496A79" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                                </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E9EDE8">
            <DockPanel Margin="20,0">
                <TextBlock Text="MAKE MUSIC  ·  오프라인 프로젝트" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="악기 설정" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
